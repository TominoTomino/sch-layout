{
  "schemaVersion": "0.1.0",
  "version": "0.3.0",
  "note": "Rules are append-only. Adding a rule is the normal way this project improves; deleting one requires a written reason in references/design-notes.md.",
  "rules": [
    {
      "id": "grid-off",
      "severity": "error",
      "weight": 1,
      "requires": [
        "components",
        "wires"
      ],
      "desc": "坐标不在栅格上",
      "why": "不在同一栅格上的元件与导线，放大后就看出参差，是最廉价也最致命的可读性损失。"
    },
    {
      "id": "overlap",
      "severity": "error",
      "weight": 1,
      "requires": [
        "components"
      ],
      "desc": "元件包围盒相交",
      "why": "重叠直接导致无法辨认符号与文字。"
    },
    {
      "id": "pin-unconnected",
      "severity": "error",
      "weight": 1,
      "requires": [
        "pinNet"
      ],
      "desc": "引脚没有网络归属（真正未连接）",
      "why": "以 EDA 自己导出的网表为准。设计者主动标了 NC 的引脚不算。这是唯一可信的连通性判据。"
    },
    {
      "id": "dangling-wire",
      "severity": "info",
      "weight": 0.15,
      "requires": [
        "components",
        "wires"
      ],
      "desc": "导线端点几何上不接触任何引脚/标签/线段",
      "why": "仅作排版参考。实测 42 条里 24 条附近存在同网络引脚，网表也判定已连接——引脚的可连接范围比 (x,y) 端点大，几何判断不可靠。真连通性见 pin-unconnected。"
    },
    {
      "id": "diagonal",
      "severity": "error",
      "weight": 0.9,
      "requires": [
        "wires"
      ],
      "desc": "存在斜线段",
      "why": "斜线破坏正交网格感，也让交叉判定变复杂。"
    },
    {
      "id": "too-many-bends",
      "severity": "warn",
      "weight": 0.8,
      "requires": [
        "wires"
      ],
      "desc": "单条导线拐点超过上限",
      "why": "绕远路的导线会让读者失去追踪兴趣。"
    },
    {
      "id": "wire-through-body",
      "severity": "warn",
      "weight": 0.7,
      "requires": [
        "components",
        "wires"
      ],
      "desc": "导线穿过元件本体",
      "why": "基于包围盒近似判定，边距已内缩，可能误报；但真命中时非常难看。"
    },
    {
      "id": "density",
      "severity": "warn",
      "weight": 0.6,
      "requires": [
        "components"
      ],
      "desc": "单页元件数超过上限",
      "why": "超过阈值后布局算法无法兼顾，人眼也无法一次看懂，应拆页。"
    },
    {
      "id": "label-overlap",
      "severity": "warn",
      "weight": 0.5,
      "requires": [
        "components",
        "labels"
      ],
      "desc": "网络标签与元件或导线重叠",
      "why": "标签压线是自动生成原理图最常见的可读性杀手。"
    }
  ],
  "metrics": [
    {
      "id": "crossings",
      "weight": 0.35,
      "desc": "导线交叉数（共享端点不算）",
      "normalize": "perComponent",
      "scoringWeight": 0
    },
    {
      "id": "bends",
      "weight": 0.25,
      "desc": "拐点总数",
      "normalize": "perComponent",
      "scoringWeight": 0
    },
    {
      "id": "wireLength",
      "weight": 0.2,
      "desc": "导线总长（栅格单位）",
      "normalize": "perComponent",
      "scoringWeight": 0
    },
    {
      "id": "compactness",
      "weight": 0.2,
      "desc": "内容外接框填充率，过低说明散得太开",
      "normalize": "ratio",
      "scoringWeight": 0
    }
  ],
  "scoring": {
    "formula": "score = clamp(100 - violationPenalty, 0, 100)  (指标仅报告，不计分，见 D23)",
    "violationPenalty": "sum over failing rules of min(weight * severityMult * count, perRuleCap)",
    "metricPenalty": "disabled (D23)",
    "severityMult": {
      "error": 1,
      "warn": 0.55,
      "info": 0.2
    },
    "metricReference": {
      "crossings_perComponent": 2,
      "bends_perComponent": 6,
      "wireLength_perComponent": 60,
      "compactness_idealMin": 0.25
    },
    "calibration": "PARTIAL: 4 human ratings. Metrics excluded from scoring; violation penalty linear. Refit only if more ratings show residuals.",
    "perRuleCap": 40
  }
}

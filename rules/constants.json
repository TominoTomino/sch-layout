{
  "schemaVersion": "0.2.0",
  "version": "0.6.0",
  "unit": "0.01in",
  "grid": 5,
  "spacing": {
    "componentMin": 20,
    "blockGap": 40,
    "labelClearance": 6,
    "pinStubLength": 10
  },
  "routing": {
    "maxBendsPerWire": 2,
    "allowDiagonal": false,
    "preferNetLabelAcrossBlocks": true
  },
  "orientation": {
    "powerSymbolFacing": "up",
    "groundSymbolFacing": "down",
    "signalFlow": "left-to-right"
  },
  "limits": {
    "maxComponentsPerPage": 20,
    "maxBlocksPerPage": 6,
    "minComponentsPerBlock": 1,
    "minOverlapRatio": 0.35,
    "gridTolerance": 0.1,
    "_gridToleranceWhy": "真实数据里写入后会出现 ~0.05 单位的亚单位漂移（半 mil），属数值噪声；判 off-grid 必须带容差，否则 5 栅格页会被判成 1 栅格页（D33/D34）"
  },
  "provenance": {
    "_note": "Every number must record where it came from. Written by measure.mjs, never hand-edited without updating this block.",
    "componentMin": {
      "source": "PLACEHOLDER",
      "method": "assumed",
      "n": 0
    },
    "blockGap": {
      "source": "PLACEHOLDER",
      "method": "assumed",
      "n": 0
    },
    "labelClearance": {
      "source": "PLACEHOLDER",
      "method": "assumed",
      "n": 0
    },
    "pinStubLength": {
      "source": "PLACEHOLDER",
      "method": "assumed",
      "n": 0
    },
    "grid": {
      "source": "measure on 3 real projects",
      "method": "grid coverage mode (largest grid with >=95% coverage)",
      "n": 3,
      "samples": [
        {
          "project": "CW32 hub",
          "components": 174,
          "grid": 5,
          "coverage": 1
        },
        {
          "project": "ouya 过欠压",
          "components": 59,
          "grid": 5,
          "coverage": 0.983
        },
        {
          "project": "yosemite DRAM",
          "components": 34,
          "grid": 5,
          "coverage": 1
        }
      ]
    }
  },
  "styleObservations": {
    "_note": "实测到的数值，不是标准。三项之间差异达数倍，说明它们随项目风格变化，不能当全局常量用（D41）。",
